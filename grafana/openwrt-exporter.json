      },
      "targets": [
        {
          "expr": "openwrt_network_up{instance=~\"$instance\", device=~\"$device\"}",
          "legendFormat": "{{device}} up",
          "refId": "A"
        },
        {
          "expr": "openwrt_network_carrier{instance=~\"$instance\", device=~\"$device\"}",
          "legendFormat": "{{device}} carrier",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "有线接口协商速率",
      "description": "与 LuCI「端口状态」同类：lanN / eth1 / wan*。排除 br-*（桥 speed 无意义）、lo/wlan/phy。Filogic DSA 上 eth0 多为接交换机的 CPU/SoC 口（常报 2500），LuCI 端口页不展示，本面板默认也不画；若你的 WAN 是 eth0，可把查询改成含 eth0 或改用 device 变量。过滤 ≤0（含未知 -1）。",
      "id": 20,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Mbps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "drawStyle": "line",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "openwrt_network_speed_mbps{instance=~\"$instance\", device=~\"$device\", device=~\"^(lan[0-9]+|eth1|wan.*)$\"} > 0",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ]
    },
