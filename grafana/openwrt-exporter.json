{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "OpenWrt Prometheus exporter：CPU/内存/负载/温度/uptime、conntrack、接口吞吐、DHCP 与无线概览。导入见 docs/prometheus.md。",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "系统",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "CPU 使用率",
      "id": 1,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "expr": "openwrt_cpu_usage_ratio{instance=~\"$instance\"} * 100",
          "legendFormat": "CPU%",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "内存使用率",
      "id": 2,
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "expr": "openwrt_memory_usage_ratio{instance=~\"$instance\"} * 100",
          "legendFormat": "Mem%",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "负载 (1m)",
      "id": 3,
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "expr": "openwrt_load_1{instance=~\"$instance\"}",
          "legendFormat": "load1",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "温度",
      "id": 4,
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "expr": "openwrt_thermal_celsius{instance=~\"$instance\"}",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Uptime",
      "id": 5,
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "expr": "openwrt_system_uptime_seconds{instance=~\"$instance\"}",
          "legendFormat": "uptime",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Conntrack",
      "id": 6,
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "expr": "openwrt_conntrack_entries{instance=~\"$instance\"}",
          "legendFormat": "entries",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU / 内存使用率",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "openwrt_cpu_usage_ratio{instance=~\"$instance\"} * 100",
          "legendFormat": "CPU%",
          "refId": "A"
        },
        {
          "expr": "openwrt_memory_usage_ratio{instance=~\"$instance\"} * 100",
          "legendFormat": "Mem%",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "负载",
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "openwrt_load_1{instance=~\"$instance\"}",
          "legendFormat": "1m",
          "refId": "A"
        },
        {
          "expr": "openwrt_load_5{instance=~\"$instance\"}",
          "legendFormat": "5m",
          "refId": "B"
        },
        {
          "expr": "openwrt_load_15{instance=~\"$instance\"}",
          "legendFormat": "15m",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Conntrack 使用率",
      "id": 9,
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 1, "fillOpacity": 15, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "openwrt_conntrack_entries{instance=~\"$instance\"} / openwrt_conntrack_max{instance=~\"$instance\"}",
          "legendFormat": "conntrack fill",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "温度 (°C)",
      "id": 10,
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "openwrt_thermal_celsius{instance=~\"$instance\"}",
          "legendFormat": "{{zone}} {{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "网络接口",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "id": 101,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "接口吞吐 (receive)",
      "id": 11,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "rate(openwrt_network_receive_bytes_total{instance=~\"$instance\", device=~\"$device\"}[5m]) * 8",
          "legendFormat": "{{device}} rx",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "接口吞吐 (transmit)",
      "id": 12,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "rate(openwrt_network_transmit_bytes_total{instance=~\"$instance\", device=~\"$device\"}[5m]) * 8",
          "legendFormat": "{{device}} tx",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "接口 up / carrier",
      "id": 13,
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "openwrt_network_up{instance=~\"$instance\", device=~\"$device\"}",
          "legendFormat": "{{device}} up",
          "refId": "A"
        },
        {
          "expr": "openwrt_network_carrier{instance=~\"$instance\", device=~\"$device\"}",
          "legendFormat": "{{device}} carrier",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "DHCP / 无线",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "id": 102,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "DHCP 租约数",
      "id": 14,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "expr": "openwrt_dhcp_leases{instance=~\"$instance\"}",
          "legendFormat": "leases",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "无线关联站",
      "id": 15,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "expr": "openwrt_wireless_stations{instance=~\"$instance\"}",
          "legendFormat": "stations",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DHCP 租约 / 无线站数",
      "id": 16,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "openwrt_dhcp_leases{instance=~\"$instance\"}",
          "legendFormat": "DHCP leases",
          "refId": "A"
        },
        {
          "expr": "openwrt_wireless_stations{instance=~\"$instance\"}",
          "legendFormat": "Wi-Fi stations",
          "refId": "B"
        }
      ]
    },
    {
      "type": "table",
      "title": "无线站点（设备信息）",
      "id": 18,
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": true },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Signal (dBm)" },
            "properties": [{ "id": "unit", "value": "dBm" }]
          },
          {
            "matcher": { "id": "byName", "options": "RX bps" },
            "properties": [{ "id": "unit", "value": "bps" }]
          },
          {
            "matcher": { "id": "byName", "options": "TX bps" },
            "properties": [{ "id": "unit", "value": "bps" }]
          },
          {
            "matcher": { "id": "byName", "options": "RX PHY Mbps" },
            "properties": [{ "id": "unit", "value": "Mbps" }]
          },
          {
            "matcher": { "id": "byName", "options": "TX PHY Mbps" },
            "properties": [{ "id": "unit", "value": "Mbps" }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false },
        "sortBy": [{ "displayName": "hostname", "desc": false }]
      },
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": false
            },
            "indexByName": {
              "hostname": 0,
              "ip": 1,
              "mac": 2,
              "iface": 3,
              "ssid": 4,
              "Signal (dBm)": 5,
              "Noise (dBm)": 6,
              "RX PHY Mbps": 7,
              "TX PHY Mbps": 8,
              "RX bps": 9,
              "TX bps": 10
            },
            "renameByName": {}
          }
        }
      ],
      "targets": [
        {
          "expr": "openwrt_wireless_station_info{instance=~\"$instance\"}",
          "format": "table",
          "instant": true,
          "refId": "Info"
        },
        {
          "expr": "openwrt_wireless_station_signal_dbm{instance=~\"$instance\"}",
          "format": "table",
          "instant": true,
          "refId": "Signal",
          "legendFormat": "Signal (dBm)"
        },
        {
          "expr": "openwrt_wireless_station_noise_dbm{instance=~\"$instance\"}",
          "format": "table",
          "instant": true,
          "refId": "Noise",
          "legendFormat": "Noise (dBm)"
        },
        {
          "expr": "openwrt_wireless_station_receive_rate_mbps{instance=~\"$instance\"}",
          "format": "table",
          "instant": true,
          "refId": "RxPhy",
          "legendFormat": "RX PHY Mbps"
        },
        {
          "expr": "openwrt_wireless_station_transmit_rate_mbps{instance=~\"$instance\"}",
          "format": "table",
          "instant": true,
          "refId": "TxPhy",
          "legendFormat": "TX PHY Mbps"
        },
        {
          "expr": "rate(openwrt_wireless_station_receive_bytes_total{instance=~\"$instance\"}[5m]) * 8",
          "format": "table",
          "instant": true,
          "refId": "RxBps",
          "legendFormat": "RX bps"
        },
        {
          "expr": "rate(openwrt_wireless_station_transmit_bytes_total{instance=~\"$instance\"}[5m]) * 8",
          "format": "table",
          "instant": true,
          "refId": "TxBps",
          "legendFormat": "TX bps"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "无线每站吞吐 (bps)",
      "id": 17,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 54 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": { "lineWidth": 1, "fillOpacity": 5, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "rate(openwrt_wireless_station_receive_bytes_total{instance=~\"$instance\"}[5m]) * 8 * on(instance, mac, iface) group_left(hostname, ip) openwrt_wireless_station_info{instance=~\"$instance\"}",
          "legendFormat": "{{hostname}} {{mac}} rx",
          "refId": "A"
        },
        {
          "expr": "rate(openwrt_wireless_station_transmit_bytes_total{instance=~\"$instance\"}[5m]) * 8 * on(instance, mac, iface) group_left(hostname, ip) openwrt_wireless_station_info{instance=~\"$instance\"}",
          "legendFormat": "{{hostname}} {{mac}} tx",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["openwrt", "exporter", "prometheus"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(openwrt_load_1, instance)",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(openwrt_network_receive_bytes_total{instance=~\"$instance\"}, device)",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "OpenWrt Exporter",
  "uid": "openwrt-exporter",
  "version": 1,
  "weekStart": ""
}
