        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "openwrt_cpu_usage_ratio{instance=~\"$instance\"} * 100",
          "legendFormat": "CPU%",
          "refId": "A"
