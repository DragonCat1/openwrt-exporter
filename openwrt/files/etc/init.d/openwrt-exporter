#!/bin/sh /etc/rc.common
# OpenWrt procd init：前台 Listen，不自行 daemonize；stdout → logread。

START=99
STOP=10
USE_PROCD=1

NAME=openwrt-exporter
PROG=/usr/bin/openwrt-exporter

start_service() {
	config_load "$NAME"

	local enabled listen
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get listen main listen ':9100'

	procd_open_instance
	procd_set_param command "$PROG" -listen "$listen"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
}
